<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thiên Minh Networks — AI Agent</title>
  <script src="https://www.gstatic.com/antigravity/web/dev/tailwindcss.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --brand: #7C3AED;
      --brand2: #EC4899;
      --accent: #06B6D4;
      --bg: #0A0D16;
      --bg2: #111827;
      --card: #161D2F;
      --border: rgba(255,255,255,0.08);
      --border2: rgba(255,255,255,0.14);
      --text: #F1F5F9;
      --muted: #94A3B8;
      --dim: #475569;
    }
    * { font-family: 'Inter', system-ui, sans-serif; box-sizing: border-box; margin: 0; padding: 0; }
    html, body { background: var(--bg); color: var(--text); overflow-x: hidden; }

    /* ---- SCROLLBAR ---- */
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-thumb { background: rgba(124,58,237,.4); border-radius: 99px; }

    /* ---- PAGE VIEWS ---- */
    .view { display: none; }
    .view.active { display: flex; }

    /* ============================================================
       LANDING PAGE
    ============================================================ */
    #landing {
      min-height: 100vh;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }
    .land-bg {
      position: fixed; inset: 0; pointer-events: none;
      background:
        radial-gradient(ellipse 70% 60% at 20% 10%, rgba(124,58,237,.25) 0%, transparent 60%),
        radial-gradient(ellipse 60% 50% at 80% 90%, rgba(6,182,212,.18) 0%, transparent 60%),
        radial-gradient(ellipse 50% 40% at 50% 50%, rgba(236,72,153,.1) 0%, transparent 70%);
    }
    /* floating orbs */
    .orb {
      position: absolute; border-radius: 50%; filter: blur(80px); pointer-events: none;
      animation: float 8s ease-in-out infinite;
    }
    .orb1 { width: 400px; height: 400px; background: rgba(124,58,237,.2); top: -100px; left: -100px; }
    .orb2 { width: 300px; height: 300px; background: rgba(6,182,212,.15); bottom: -60px; right: -60px; animation-delay: -4s; }
    .orb3 { width: 200px; height: 200px; background: rgba(236,72,153,.12); top: 60%; left: 10%; animation-delay: -2s; }
    @keyframes float {
      0%,100% { transform: translateY(0) scale(1); }
      50% { transform: translateY(-30px) scale(1.05); }
    }

    /* grid pattern overlay */
    .grid-pattern {
      position: fixed; inset: 0; pointer-events: none; opacity: .04;
      background-image: linear-gradient(rgba(255,255,255,.8) 1px, transparent 1px),
                        linear-gradient(90deg, rgba(255,255,255,.8) 1px, transparent 1px);
      background-size: 60px 60px;
    }

    .land-content {
      position: relative; z-index: 10;
      text-align: center; padding: 24px;
      max-width: 680px;
      animation: fadeUp .8s cubic-bezier(.16,1,.3,1) forwards;
    }
    @keyframes fadeUp {
      from { opacity:0; transform: translateY(32px); }
      to { opacity:1; transform: translateY(0); }
    }

    .land-logo {
      width: 72px; height: 72px; border-radius: 20px;
      background: linear-gradient(135deg, #7c3aed, #ec4899);
      display: flex; align-items: center; justify-content: center;
      font-size: 24px; font-weight: 900; color: white;
      margin: 0 auto 24px;
      box-shadow: 0 20px 50px -10px rgba(124,58,237,.6);
      position: relative; overflow: hidden;
    }
    .land-logo::after {
      content: ''; position: absolute; top: 0; left: -100%;
      width: 60%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.3), transparent);
      animation: logoShimmer 3s infinite;
    }
    @keyframes logoShimmer { 0%{left:-100%} 60%,100%{left:150%} }

    .land-badge {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 6px 16px; border-radius: 99px;
      background: rgba(124,58,237,.12); border: 1px solid rgba(124,58,237,.35);
      font-size: 12px; font-weight: 600; color: #A78BFA;
      margin-bottom: 20px;
    }
    .land-badge .dot { width: 6px; height: 6px; border-radius: 50%; background: #A78BFA; animation: pulse 2s infinite; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }

    .land-title {
      font-size: clamp(32px, 6vw, 56px);
      font-weight: 900; line-height: 1.1;
      letter-spacing: -1.5px;
      background: linear-gradient(135deg, #fff 0%, #C4B5FD 50%, #67E8F9 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      background-clip: text; margin-bottom: 16px;
    }
    .land-sub {
      font-size: 16px; color: var(--muted); line-height: 1.7;
      max-width: 520px; margin: 0 auto 36px;
    }

    .land-actions { display: flex; align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; }
    .btn-land {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 14px 32px; border-radius: 14px;
      font-size: 15px; font-weight: 700; cursor: pointer;
      transition: all .2s ease; border: none;
    }
    .btn-land-primary {
      background: linear-gradient(135deg, #7c3aed, #ec4899);
      color: white;
      box-shadow: 0 8px 30px -6px rgba(124,58,237,.6);
    }
    .btn-land-primary:hover { transform: translateY(-2px); filter: brightness(1.1); box-shadow: 0 16px 40px -8px rgba(124,58,237,.7); }
    .btn-land-ghost {
      background: rgba(255,255,255,.06); color: var(--muted);
      border: 1px solid var(--border2); font-size: 14px; padding: 13px 24px;
    }
    .btn-land-ghost:hover { background: rgba(255,255,255,.1); color: var(--text); }

    .land-features {
      display: flex; align-items: center; justify-content: center;
      gap: 20px; flex-wrap: wrap; margin-top: 44px;
    }
    .feat-item {
      display: flex; align-items: center; gap: 8px;
      font-size: 12px; color: var(--dim); font-weight: 500;
    }
    .feat-item svg { color: #7c3aed; }

    /* stats row on landing */
    .land-stats {
      display: grid; grid-template-columns: repeat(3, 1fr);
      gap: 1px; background: var(--border);
      border: 1px solid var(--border); border-radius: 16px;
      overflow: hidden; margin-top: 48px;
    }
    .land-stat {
      background: rgba(22,29,47,.8); padding: 20px 24px; text-align: center;
      backdrop-filter: blur(12px);
    }
    .land-stat-num { font-size: 26px; font-weight: 800; background: linear-gradient(135deg,#A78BFA,#67E8F9); -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text; }
    .land-stat-lbl { font-size: 11px; color: var(--dim); margin-top: 2px; font-weight: 500; letter-spacing: .04em; }

    /* ============================================================
       APP SHELL
    ============================================================ */
    #app {
      min-height: 100vh;
      flex-direction: column;
    }

    /* ---- TOP NAV ---- */
    .topnav {
      height: 56px; display: flex; align-items: center; justify-content: space-between;
      padding: 0 24px; border-bottom: 1px solid var(--border);
      background: rgba(10,13,22,.9); backdrop-filter: blur(16px);
      position: sticky; top: 0; z-index: 50; flex-shrink: 0;
    }
    .topnav-brand { display: flex; align-items: center; gap: 10px; }
    .topnav-logo {
      width: 32px; height: 32px; border-radius: 9px;
      background: linear-gradient(135deg,#7c3aed,#ec4899);
      display: flex; align-items: center; justify-content: center;
      font-size: 11px; font-weight: 900; color: white;
    }
    .topnav-name { font-size: 14px; font-weight: 700; color: white; }
    .topnav-sub { font-size: 10px; color: var(--muted); }

    /* ---- TABS ---- */
    .tab-bar {
      display: flex; align-items: center; gap: 2px;
      background: rgba(255,255,255,.04); padding: 4px; border-radius: 12px;
    }
    .tab-btn {
      padding: 7px 16px; border-radius: 9px; border: none; cursor: pointer;
      font-size: 12px; font-weight: 600; transition: all .2s;
      background: transparent; color: var(--muted);
      display: flex; align-items: center; gap: 6px;
    }
    .tab-btn:hover { color: var(--text); background: rgba(255,255,255,.06); }
    .tab-btn.active { background: rgba(124,58,237,.25); color: #C4B5FD; border: 1px solid rgba(124,58,237,.35); }
    .tab-btn .tab-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }

    .topnav-right { display: flex; align-items: center; gap: 10px; }
    .status-pill {
      display: flex; align-items: center; gap: 6px;
      padding: 5px 12px; border-radius: 99px;
      background: rgba(16,185,129,.1); border: 1px solid rgba(16,185,129,.25);
      font-size: 11px; font-weight: 600; color: #34D399;
    }
    .status-dot { width: 6px; height: 6px; border-radius: 50%; background: #34D399; animation: pulse 2s infinite; }
    .btn-back {
      display: flex; align-items: center; gap: 6px;
      padding: 6px 14px; border-radius: 9px; border: 1px solid var(--border2);
      background: transparent; color: var(--muted); font-size: 12px; font-weight: 600;
      cursor: pointer; transition: all .2s;
    }
    .btn-back:hover { color: var(--text); border-color: var(--border2); background: rgba(255,255,255,.06); }

    /* ---- TAB PANELS ---- */
    .tab-panels { flex: 1; overflow: hidden; display: flex; flex-direction: column; }
    .tab-panel { display: none; flex: 1; overflow-y: auto; }
    .tab-panel.active { display: block; }
    .tab-panel::-webkit-scrollbar { width: 4px; }
    .tab-panel::-webkit-scrollbar-thumb { background: rgba(124,58,237,.3); border-radius: 99px; }

    .panel-inner { max-width: 1100px; margin: 0 auto; padding: 28px 24px; }

    /* ============================================================
       SHARED COMPONENTS
    ============================================================ */
    .page-header { margin-bottom: 24px; }
    .page-title { font-size: 20px; font-weight: 800; color: white; letter-spacing: -.5px; }
    .page-desc { font-size: 13px; color: var(--muted); margin-top: 4px; line-height: 1.6; }

    .card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 18px; padding: 20px;
      transition: border-color .25s;
    }
    .card:hover { border-color: rgba(124,58,237,.25); }

    .card-title { font-size: 13px; font-weight: 700; color: white; margin-bottom: 4px; }
    .card-sub { font-size: 11px; color: var(--muted); }
    .card-label { font-size: 10px; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; color: var(--dim); margin-bottom: 12px; }

    .badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 99px; font-size: 11px; font-weight: 600; }
    .g { background:rgba(16,185,129,.12); color:#34D399; border:1px solid rgba(16,185,129,.25); }
    .a { background:rgba(245,158,11,.12); color:#FCD34D; border:1px solid rgba(245,158,11,.25); }
    .r { background:rgba(244,63,94,.12); color:#FB7185; border:1px solid rgba(244,63,94,.25); }
    .p { background:rgba(139,92,246,.12); color:#A78BFA; border:1px solid rgba(139,92,246,.25); }
    .c { background:rgba(6,182,212,.12); color:#22D3EE; border:1px solid rgba(6,182,212,.25); }
    .b { background:rgba(59,130,246,.12); color:#60A5FA; border:1px solid rgba(59,130,246,.25); }

    .bar-track { background: rgba(255,255,255,.06); border-radius: 99px; overflow: hidden; }
    .bar-fill { border-radius: 99px; transition: width 1s cubic-bezier(.16,1,.3,1); }

    .btn-primary {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 10px 20px; border-radius: 11px; border: none; cursor: pointer;
      font-size: 13px; font-weight: 700; color: white;
      background: linear-gradient(135deg,#7c3aed,#ec4899);
      box-shadow: 0 4px 15px -4px rgba(124,58,237,.5);
      transition: all .2s;
    }
    .btn-primary:hover { transform: translateY(-1px); filter: brightness(1.1); }
    .btn-primary:active { transform: scale(.97); }
    .btn-ghost {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 9px 16px; border-radius: 10px;
      border: 1px solid var(--border2); background: transparent;
      color: var(--muted); font-size: 12px; font-weight: 600; cursor: pointer;
      transition: all .2s;
    }
    .btn-ghost:hover { color: white; background: rgba(255,255,255,.07); }
    .btn-success {
      display: inline-flex; align-items: center; gap: 7px;
      padding: 10px 20px; border-radius: 11px; border: none; cursor: pointer;
      font-size: 13px; font-weight: 700; color: white;
      background: linear-gradient(135deg,#059669,#06b6d4);
      box-shadow: 0 4px 15px -4px rgba(5,150,105,.4);
      transition: all .2s;
    }
    .btn-success:hover { transform: translateY(-1px); filter: brightness(1.08); }
    .btn-warn {
      padding: 8px 14px; border-radius: 10px; border: 1px solid rgba(245,158,11,.3);
      background: rgba(245,158,11,.1); color: #FCD34D;
      font-size: 12px; font-weight: 600; cursor: pointer; transition: all .2s;
    }
    .btn-warn:hover { background: rgba(245,158,11,.2); }
    .btn-danger {
      padding: 8px 14px; border-radius: 10px; border: 1px solid rgba(244,63,94,.3);
      background: rgba(244,63,94,.1); color: #FB7185;
      font-size: 12px; font-weight: 600; cursor: pointer; transition: all .2s;
    }
    .btn-danger:hover { background: rgba(244,63,94,.2); }

    .input {
      width: 100%; padding: 10px 14px; border-radius: 11px;
      border: 1px solid var(--border2); background: rgba(255,255,255,.04);
      color: white; font-size: 13px; outline: none; transition: all .2s;
    }
    .input::placeholder { color: var(--dim); }
    .input:focus { border-color: rgba(124,58,237,.5); box-shadow: 0 0 0 3px rgba(124,58,237,.12); }

    .divider { height: 1px; background: var(--border); }
    .sep { display: flex; align-items: center; gap: 10px; }
    .sep span { font-size: 11px; color: var(--dim); white-space: nowrap; }
    .sep::before, .sep::after { content:''; flex:1; height:1px; background:var(--border); }

    /* ---- MODAL ---- */
    .modal-backdrop {
      position: fixed; inset: 0; z-index: 100;
      background: rgba(0,0,0,.7); backdrop-filter: blur(8px);
      display: flex; align-items: center; justify-content: center; padding: 16px;
    }
    .modal {
      background: #161D2F; border: 1px solid var(--border2);
      border-radius: 22px; width: 100%; padding: 24px;
      box-shadow: 0 40px 80px -20px rgba(0,0,0,.8);
      animation: scaleIn .25s cubic-bezier(.34,1.56,.64,1);
      max-height: 90vh; overflow-y: auto;
    }
    .modal::-webkit-scrollbar { width: 4px; }
    .modal::-webkit-scrollbar-thumb { background: rgba(124,58,237,.3); border-radius:99px; }
    @keyframes scaleIn { from{opacity:0;transform:scale(.94)} to{opacity:1;transform:scale(1)} }
    .modal-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 20px; }
    .modal-title { font-size: 15px; font-weight: 800; color: white; }
    .modal-sub { font-size: 12px; color: var(--muted); margin-top: 3px; }
    .btn-close { width: 28px; height: 28px; border-radius: 8px; border: 1px solid var(--border2); background: transparent; color: var(--muted); font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all .2s; }
    .btn-close:hover { background: rgba(255,255,255,.08); color: white; }

    /* ---- TOAST ---- */
    .toast {
      background: #1E2740; border: 1px solid var(--border2);
      border-radius: 13px; padding: 13px 15px;
      display: flex; align-items: flex-start; gap: 11px;
      box-shadow: 0 20px 50px rgba(0,0,0,.5); max-width: 340px;
      pointer-events: auto;
      animation: toastIn .3s cubic-bezier(.16,1,.3,1);
    }
    @keyframes toastIn { from{opacity:0;transform:translateX(20px)} to{opacity:1;transform:none} }

    /* ---- AVATAR ---- */
    .ava { width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 800; flex-shrink: 0; }

    /* ---- HOLO CARD ---- */
    .holo {
      background: linear-gradient(135deg,#7c3aed 0%,#db2777 50%,#0891b2 100%);
      border-radius: 18px; padding: 22px; position: relative; overflow: hidden;
      cursor: pointer; transform-style: preserve-3d;
      transition: transform .15s ease-out;
    }
    .holo::before {
      content:''; position:absolute; inset:0;
      background: radial-gradient(circle at var(--mx,50%) var(--my,30%), rgba(255,255,255,.4) 0%, transparent 60%);
      mix-blend-mode: overlay; pointer-events: none;
    }
    .holo-shine {
      position:absolute; top:0; left:-100%; width:55%; height:100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,.18), transparent);
      transform: skewX(-20deg);
      animation: shine 5s infinite 1.5s;
    }
    @keyframes shine { 0%{left:-100%} 40%,100%{left:160%} }

    /* ---- PIPELINE STEP ---- */
    .pstep {
      border-radius: 14px; padding: 18px; border: 1px solid;
      position: relative; overflow: hidden;
    }
    .pstep::before { content:''; position:absolute; top:0; left:0; right:0; height:2px; border-radius:14px 14px 0 0; }
    .ps-blue  { background:rgba(59,130,246,.05);  border-color:rgba(59,130,246,.2);  }
    .ps-blue::before  { background:linear-gradient(90deg,#3B82F6,#06B6D4); }
    .ps-indigo{ background:rgba(99,102,241,.05);  border-color:rgba(99,102,241,.2);  }
    .ps-indigo::before{ background:linear-gradient(90deg,#6366F1,#EC4899); }
    .ps-amber { background:rgba(245,158,11,.05);  border-color:rgba(245,158,11,.2);  }
    .ps-amber::before { background:linear-gradient(90deg,#F59E0B,#EF4444); }
    .ps-green { background:rgba(16,185,129,.05);  border-color:rgba(16,185,129,.2);  }
    .ps-green::before { background:linear-gradient(90deg,#10B981,#06B6D4); }
    .ps-rose  { background:rgba(244,63,94,.05);   border-color:rgba(244,63,94,.2);   }
    .ps-rose::before  { background:linear-gradient(90deg,#F43F5E,#EF4444); }

    /* ---- CHAT ---- */
    .chat-user { background:linear-gradient(135deg,#7c3aed,#db2777); color:white; border-radius:16px 16px 4px 16px; padding:10px 14px; font-size:13px; line-height:1.6; max-width:82%; }
    .chat-ai   { background:rgba(255,255,255,.06); border:1px solid var(--border); color:var(--text); border-radius:16px 16px 16px 4px; padding:10px 14px; font-size:13px; line-height:1.6; max-width:82%; white-space:pre-wrap; }

    /* ---- GAUGE ---- */
    .gauge-bg   { stroke:rgba(255,255,255,.07); }
    .gauge-fill { stroke-linecap:round; transition:stroke-dasharray 1.1s cubic-bezier(.16,1,.3,1); }

    /* ---- ANIMATE ---- */
    @keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:none} }
    .fade-up { animation: fadeUp .4s cubic-bezier(.16,1,.3,1) forwards; }

    /* ---- GRID HELPERS ---- */
    .g2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .g3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; }
    .g4 { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; }
    @media(max-width:768px) { .g3,.g4{grid-template-columns:1fr 1fr} .g2{grid-template-columns:1fr} }
    @media(max-width:520px) { .g3,.g4{grid-template-columns:1fr} }

    .space-y > * + * { margin-top: 14px; }
    .space-y-sm > * + * { margin-top: 10px; }
    .space-y-lg > * + * { margin-top: 20px; }

    /* ---- PRESET SELECTOR ---- */
    .preset-opt {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 16px; border-radius: 13px; border: 1px solid;
      cursor: pointer; transition: all .2s; margin-bottom: 8px;
    }
    .preset-opt:hover { transform: translateY(-1px); }
    .po-green { border-color:rgba(16,185,129,.2); background:rgba(16,185,129,.06); }
    .po-green:hover { border-color:rgba(16,185,129,.4); background:rgba(16,185,129,.1); }
    .po-amber { border-color:rgba(245,158,11,.2); background:rgba(245,158,11,.06); }
    .po-amber:hover { border-color:rgba(245,158,11,.4); background:rgba(245,158,11,.1); }
    .po-rose  { border-color:rgba(244,63,94,.2);  background:rgba(244,63,94,.06); }
    .po-rose:hover  { border-color:rgba(244,63,94,.4);  background:rgba(244,63,94,.1); }
  </style>
</head>
<body>

<!-- TOAST CONTAINER -->
<div id="toast-container" style="position:fixed;top:18px;right:18px;z-index:200;display:flex;flex-direction:column;gap:8px;pointer-events:none;"></div>

<!-- ============================================================
     VIEW 1: LANDING PAGE
============================================================ -->
<div id="landing" class="view active">
  <div class="land-bg"></div>
  <div class="grid-pattern"></div>
  <div class="orb orb1"></div>
  <div class="orb orb2"></div>
  <div class="orb orb3"></div>

  <div class="land-content">
    <!-- Logo -->
    <div class="land-logo">TM</div>

    <!-- Badge -->
    <div class="land-badge">
      <span class="dot"></span>
      AI Agent · Phiên bản 2.5 · Gemini 3.5 Flash
    </div>

    <!-- Title -->
    <h1 class="land-title">Hệ Thống Đánh Giá<br>Hồ Sơ Chào Giá</h1>

    <!-- Subtitle -->
    <p class="land-sub">
      Tự động phân tích yêu cầu kỹ thuật, đối chiếu danh mục, tính toán chiết khấu và tạo bộ hồ sơ doanh nghiệp hoàn chỉnh — chỉ trong vài giây.
    </p>

    <!-- Actions -->
    <div class="land-actions">
      <button class="btn-land btn-land-primary" onclick="goToApp()">
        <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="5 12 12 5 19 12"/><line x1="12" y1="5" x2="12" y2="19"/></svg>
        Bắt Đầu Phân Tích
      </button>
