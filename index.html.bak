              </div>
              <div style="text-align:center;">
                <div style="position:relative;width:88px;height:88px;margin:0 auto 10px;">
                  <svg width="88" height="88" style="transform:rotate(-90deg)" viewBox="0 0 88 88">
                    <circle cx="44" cy="44" r="36" class="gauge-bg" stroke-width="7" fill="none"/>
                    <circle id="g-schedule" cx="44" cy="44" r="36" stroke="#8B5CF6" stroke-width="7" fill="none" stroke-dasharray="163 226" stroke-linecap="round" class="gauge-fill"/>
                  </svg>
                  <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:900;color:white;" id="g-schedule-txt">72%</div>
