                <div style="display:flex;justify-content:space-between;align-items:center;"><div style="display:flex;align-items:center;gap:6px;font-size:11px;color:var(--muted);"><span style="width:8px;height:8px;border-radius:50%;background:#EC4899;display:block;"></span>Thiết bị</div><span style="font-size:12px;font-weight:700;color:white;">68%</span></div>
                <div style="display:flex;justify-content:space-between;align-items:center;"><div style="display:flex;align-items:center;gap:6px;font-size:11px;color:var(--muted);"><span style="width:8px;height:8px;border-radius:50%;background:#8B5CF6;display:block;"></span>Dịch vụ</div><span style="font-size:12px;font-weight:700;color:white;">22%</span></div>
                <div style="display:flex;justify-content:space-between;align-items:center;"><div style="display:flex;align-items:center;gap:6px;font-size:11px;color:var(--muted);"><span style="width:8px;height:8px;border-radius:50%;background:#06B6D4;display:block;"></span>Chiết khấu</div><span style="font-size:12px;font-weight:700;color:white;">6%</span></div>
                <div style="display:flex;justify-content:space-between;align-items:center;"><div style="display:flex;align-items:center;gap:6px;font-size:11px;color:var(--muted);"><span style="width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.18);display:block;"></span>Dự phòng</div><span style="font-size:12px;font-weight:700;color:white;">4%</span></div>
                <div style="border-top:1px solid var(--border);padding-top:8px;margin-top:4px;">
                  <div style="display:flex;justify-content:space-between;"><span style="font-size:10px;color:var(--muted);">Lợi Nhuận Gộp</span><span id="profit-val" style="font-size:13px;font-weight:800;color:#EC4899;">95,2 Tr</span></div>
                  <div style="display:flex;justify-content:space-between;margin-top:3px;"><span style="font-size:10px;color:var(--muted);">COGS</span><span id="cogs-val" style="font-size:12px;font-weight:600;color:var(--text);">249,0 Tr</span></div>
