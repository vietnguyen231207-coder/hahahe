        <!-- Progress Bars -->
        <div class="card fade-up" style="margin-bottom:14px;">
          <div class="card-label">Thành Phần Chi Phí</div>
          <div class="space-y-sm">
            <div>
              <div style="display:flex;justify-content:space-between;margin-bottom:6px;">
                <div style="display:flex;align-items:center;gap:7px;font-size:12px;font-weight:500;color:var(--muted);"><span style="width:8px;height:8px;border-radius:50%;background:#22D3EE;display:block;"></span>Thiết Bị Switch & Firewall</div>
                <span id="bar1-val" style="font-size:12px;font-weight:700;color:#22D3EE;">80%</span>
              </div>
              <div class="bar-track" style="height:8px;"><div id="bar1-fill" class="bar-fill" style="width:80%;height:8px;background:linear-gradient(90deg,#22D3EE,#3B82F6);"></div></div>
            </div>
            <div>
              <div style="display:flex;justify-content:space-between;margin-bottom:6px;">
                <div style="display:flex;align-items:center;gap:7px;font-size:12px;font-weight:500;color:var(--muted);"><span style="width:8px;height:8px;border-radius:50%;background:#A78BFA;display:block;"></span>Dịch Vụ Thi Công & Bảo Trì</div>
                <span id="bar2-val" style="font-size:12px;font-weight:700;color:#A78BFA;">65%</span>
              </div>
              <div class="bar-track" style="height:8px;"><div id="bar2-fill" class="bar-fill" style="width:65%;height:8px;background:linear-gradient(90deg,#8B5CF6,#EC4899);"></div></div>
            </div>
            <div>
              <div style="display:flex;justify-content:space-between;margin-bottom:6px;">
                <div style="display:flex;align-items:center;gap:7px;font-size:12px;font-weight:500;color:var(--muted);"><span style="width:8px;height:8px;border-radius:50%;background:#FB7185;display:block;"></span>Tỷ Lệ Chiết Khấu / Trần Tier</div>
                <span id="bar3-val" style="font-size:12px;font-weight:700;color:#FB7185;">45%</span>
              </div>
              <div class="bar-track" style="height:8px;"><div id="bar3-fill" class="bar-fill" style="width:45%;height:8px;background:linear-gradient(90deg,#EC4899,#F43F5E);"></div></div>
            </div>
          </div>
        </div>

        <!-- 2a 2b 2c cards -->
        <div class="g3 fade-up">
          <div class="card" style="border-color:rgba(236,72,153,.2);">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
              <div style="width:30px;height:30px;border-radius:9px;background:rgba(236,72,153,.18);border:1px solid rgba(236,72,153,.3);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#F9A8D4;">2a</div>
              <span style="font-size:12px;font-weight:600;color:#F9A8D4;">Trích Xuất Thông Tin</span>
            </div>
            <div id="a-num" style="font-size:22px;font-weight:900;color:white;margin-bottom:3px;">7 Hạng mục</div>
            <div id="a-sub" style="font-size:11px;color:var(--muted);margin-bottom:10px;">100% đạt chuẩn</div>
            <span id="a-pill" class="badge g" style="font-size:10px;">366.2M VNĐ</span>
            <div id="a-lbl" style="font-size:10px;color:var(--dim);margin-top:7px;">PoE+ 370W</div>
          </div>
          <div class="card" style="border-color:rgba(99,102,241,.2);">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
              <div style="width:30px;height:30px;border-radius:9px;background:rgba(99,102,241,.18);border:1px solid rgba(99,102,241,.3);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#A5B4FC;">2b</div>
              <span style="font-size:12px;font-weight:600;color:#A5B4FC;">Khớp Catalog & Lịch</span>
            </div>
            <div id="b-num" style="font-size:22px;font-weight:900;color:white;margin-bottom:3px;">12 Ngày</div>
            <div id="b-sub" style="font-size:11px;color:var(--muted);margin-bottom:10px;">Hạn 30 ngày</div>
            <span id="b-pill" class="badge b" style="font-size:10px;">Khả thi</span>
            <div id="b-lbl" style="font-size:10px;color:var(--dim);margin-top:7px;">Lead 5d + Thi công 7d</div>
          </div>
          <div class="card" style="border-color:rgba(6,182,212,.2);">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
              <div style="width:30px;height:30px;border-radius:9px;background:rgba(6,182,212,.18);border:1px solid rgba(6,182,212,.3);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#67E8F9;">2c</div>
              <span style="font-size:12px;font-weight:600;color:#67E8F9;">Giá & Chiết Khấu</span>
            </div>
            <div id="c-num" style="font-size:22px;font-weight:900;color:white;margin-bottom:3px;">6,0% CK</div>
            <div id="c-sub" style="font-size:11px;color:var(--muted);margin-bottom:10px;">Lãi gộp 27,7%</div>
            <span id="c-pill" class="badge g" style="font-size:10px;">Hợp lệ</span>
            <div id="c-lbl" style="font-size:10px;color:var(--dim);margin-top:7px;">Trần 8,0% Tier 2</div>
          </div>
        </div>

        <!-- Phase info -->
        <div class="card fade-up" style="margin-top:14px;padding:16px 20px;">
          <div class="card-label" style="margin-bottom:0;">Ghi Chú Phân Tích</div>
          <div style="display:flex;align-items:center;gap:10px;margin-top:10px;flex-wrap:wrap;">
            <span style="font-size:11px;color:var(--muted);" id="stat1">↑ 80% Tương thích kỹ thuật</span>
            <span style="color:var(--border2);">·</span>
            <span style="font-size:11px;color:var(--muted);" id="stat2">◷ Deadline: Trước 25/12</span>
            <span style="color:var(--border2);">·</span>
            <span style="font-size:11px;color:var(--muted);" id="stat3">✓ Thẩm quyền: Trưởng phòng KD</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ==================== TAB: QUYẾT ĐỊNH ==================== -->
    <div class="tab-panel" id="panel-decision">
      <div class="panel-inner">
        <div class="page-header fade-up">
          <div class="page-title">Quyết Định & Phê Duyệt</div>
          <div class="page-desc">Phase 3: Kiểm tra con người — Điểm kiểm soát trước khi phát hành hồ sơ</div>
        </div>

        <div class="g2 fade-up" style="align-items:start;">
          <!-- Review messages -->
          <div class="card">
            <div class="card-label" style="margin-bottom:16px;">Hội Đồng Thẩm Định</div>
            <div class="space-y-sm">
              <div style="display:flex;align-items:start;gap:10px;padding-bottom:12px;border-bottom:1px solid var(--border);">
                <div class="ava" style="background:rgba(139,92,246,.2);border:1px solid rgba(139,92,246,.35);color:#C4B5FD;">TN</div>
                <div>
                  <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:4px;"><span style="font-size:12px;font-weight:700;color:white;">Trần Nam</span><span style="font-size:10px;color:var(--dim);">Trưởng phòng KD</span></div>
                  <p id="msg-sales" style="font-size:12px;color:var(--muted);line-height:1.6;">Đã đối chiếu 100% yêu cầu. Hạng mục PoE+ và Wi-Fi 6 đều khớp catalog.</p>
                </div>
              </div>
              <div style="display:flex;align-items:start;gap:10px;padding-bottom:12px;border-bottom:1px solid var(--border);">
                <div class="ava" style="background:rgba(236,72,153,.2);border:1px solid rgba(236,72,153,.35);color:#FBCFE8;">HM</div>
                <div>
                  <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:4px;"><span style="font-size:12px;font-weight:700;color:white;">Lê Hoàng Minh</span><span style="font-size:10px;color:var(--dim);">Tổng Giám Đốc</span></div>
                  <p id="msg-ceo" style="font-size:12px;color:var(--muted);line-height:1.6;">Nếu chiết khấu trong hạn mức Tier 2 (8%), cho phép xuất báo giá ngay.</p>
                </div>
              </div>
              <div style="display:flex;align-items:start;gap:10px;">
                <div class="ava" style="background:rgba(6,182,212,.2);border:1px solid rgba(6,182,212,.35);color:#A5F3FC;">VK</div>
                <div>
                  <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:4px;"><span style="font-size:12px;font-weight:700;color:white;">Nguyễn Văn Kỹ</span><span style="font-size:10px;color:var(--dim);">Kỹ thuật trưởng</span></div>
                  <p id="msg-tech" style="font-size:12px;color:var(--muted);line-height:1.6;">Thời gian thi công 7 ngày. Lịch đội kỹ sư trống, hoàn toàn đáp ứng.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Action Panel -->
          <div class="space-y">
            <div class="card">
              <div class="card-label" style="margin-bottom:12px;">Hành Động Của Trưởng Phòng</div>
              <button class="btn-success" onclick="handleAction('approve')" style="width:100%;justify-content:center;margin-bottom:8px;">
                <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                Phê Duyệt Phương Án → Xuất File
              </button>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                <button class="btn-warn" onclick="openModal('meeting-modal')">👥 Họp Hội Đồng</button>
                <button class="btn-danger" onclick="handleAction('reject')">✕ Loại Bỏ Hồ Sơ</button>
              </div>
            </div>

            <!-- Decision branches -->
            <div class="card">
              <div class="card-label" style="margin-bottom:12px;">Các Nhánh Quyết Định</div>
              <div class="space-y-sm">
                <div style="padding:10px 12px;border-radius:10px;background:rgba(16,185,129,.07);border:1px solid rgba(16,185,129,.2);">
                  <div style="font-size:11px;font-weight:700;color:#34D399;margin-bottom:3px;">1. PASS → Bước 5</div>
                  <div style="font-size:11px;color:var(--muted);">100% chuẩn, chiết khấu trong hạn mức</div>
                </div>
                <div style="padding:10px 12px;border-radius:10px;background:rgba(245,158,11,.07);border:1px solid rgba(245,158,11,.2);">
                  <div style="font-size:11px;font-weight:700;color:#FCD34D;margin-bottom:3px;">2. ESCALATE → Hội đồng → Bước 5</div>
                  <div style="font-size:11px;color:var(--muted);">Có ngoại lệ, TGĐ ký waiver cho phép</div>
                </div>
                <div style="padding:10px 12px;border-radius:10px;background:rgba(234,179,8,.07);border:2px solid rgba(234,179,8,.3);">
                  <div style="font-size:11px;font-weight:700;color:#FDE047;margin-bottom:3px;">3. ADJUST ↩ Vòng lặp Bước 3</div>
                  <div style="font-size:11px;color:var(--muted);">AI tái tính toán sau khi điều chỉnh thông số</div>
                </div>
                <div style="padding:10px 12px;border-radius:10px;background:rgba(244,63,94,.07);border:1px solid rgba(244,63,94,.2);">
                  <div style="font-size:11px;font-weight:700;color:#FB7185;margin-bottom:3px;">4. REJECT → Dừng Quy Trình</div>
                  <div style="font-size:11px;color:var(--muted);">Ngân sách &lt;70% COGS hoặc lịch bất khả thi</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ==================== TAB: XUẤT FILE ==================== -->
    <div class="tab-panel" id="panel-export">
      <div class="panel-inner">
        <div class="page-header fade-up">
          <div class="page-title">Xuất Bộ Hồ Sơ Doanh Nghiệp</div>
          <div class="page-desc">Phase 4: Tự động sinh 4 file Word chuẩn, sẵn sàng ký và đóng dấu</div>
        </div>

        <div class="g2 fade-up">
          <div class="card" style="border-color:rgba(6,182,212,.2);">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
              <div style="width:28px;height:28px;border-radius:8px;background:rgba(6,182,212,.2);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#22D3EE;">01</div>
              <span class="badge c" style="font-size:10px;">Tài liệu 1</span>
            </div>
            <div class="card-title" style="margin-bottom:4px;">Bảng Ma Trận Đáp Ứng Yêu Cầu</div>
            <div class="card-sub" style="margin-bottom:14px;">Đối chiếu từng tính năng bắt buộc: PoE, Dual PSU, 10G SFP+, Wi-Fi 6...</div>
            <a id="dl-matrix" href="/api/download/requirements_matrix" class="btn-ghost" style="width:100%;justify-content:center;text-decoration:none;">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/></svg>
              Tải file .DOCX
            </a>
          </div>
          <div class="card" style="border-color:rgba(16,185,129,.2);">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
              <div style="width:28px;height:28px;border-radius:8px;background:rgba(16,185,129,.2);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#34D399;">02</div>
              <span class="badge g" style="font-size:10px;">Tài liệu 2</span>
            </div>
            <div class="card-title" style="margin-bottom:4px;">Bản Chào Giá Thương Mại</div>
            <div class="card-sub" style="margin-bottom:14px;">Đơn giá niêm yết, chiết khấu được duyệt, VAT 10% và điều khoản thanh toán.</div>
            <a id="dl-quotation" href="/api/download/official_quotation" class="btn-ghost" style="width:100%;justify-content:center;text-decoration:none;">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/></svg>
              Tải file .DOCX
            </a>
          </div>
          <div class="card" style="border-color:rgba(245,158,11,.2);">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
              <div style="width:28px;height:28px;border-radius:8px;background:rgba(245,158,11,.2);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#FCD34D;">03</div>
              <span class="badge a" style="font-size:10px;">Tài liệu 3</span>
            </div>
            <div class="card-title" style="margin-bottom:4px;">Phiếu Chuyển Duyệt Ngoại Lệ</div>
            <div class="card-sub" style="margin-bottom:14px;">Biên bản phê duyệt chính thức của Ban Giám Đốc và Hội đồng thẩm định.</div>
            <a id="dl-approval" href="/api/download/approval_form" class="btn-ghost" style="width:100%;justify-content:center;text-decoration:none;">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/></svg>
              Tải file .DOCX
            </a>
          </div>
          <div class="card" style="border-color:rgba(139,92,246,.2);">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:14px;">
              <div style="width:28px;height:28px;border-radius:8px;background:rgba(139,92,246,.2);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#C4B5FD;">04</div>
              <span class="badge p" style="font-size:10px;">Tài liệu 4</span>
            </div>
            <div class="card-title" style="margin-bottom:4px;">Hồ Sơ Đề Xuất Kỹ Thuật</div>
            <div class="card-sub" style="margin-bottom:14px;">Kiến trúc giải pháp mạng, cam kết SLA 24/7/NBD và tiến độ 4 giai đoạn.</div>
            <button class="btn-ghost" onclick="showToast('Hồ Sơ KT','Đã tích hợp hoàn chỉnh trong hồ sơ dự án!','success')" style="width:100%;justify-content:center;">
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              Xem Hồ Sơ
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ==================== TAB: TRỢ LÝ AI ==================== -->
    <div class="tab-panel" id="panel-chat">
      <div style="display:flex;flex-direction:column;height:calc(100vh - 56px);">
        <!-- Chat header -->
        <div style="padding:16px 24px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:12px;flex-shrink:0;">
          <div style="width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,#7c3aed,#06b6d4);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:900;color:white;">AI</div>
          <div>
            <div style="font-size:13px;font-weight:700;color:white;">Trợ Lý Gemini 3.5 AI</div>
            <div style="font-size:11px;color:#34D399;display:flex;align-items:center;gap:5px;"><span style="width:5px;height:5px;border-radius:50%;background:#34D399;animation:pulse 2s infinite;display:block;"></span>Đang hoạt động · Phân tích hồ sơ chào giá</div>
          </div>
        </div>
        <!-- Messages -->
        <div id="chat-msgs" style="flex:1;overflow-y:auto;padding:20px 24px;display:flex;flex-direction:column;gap:14px;">
          <div style="display:flex;align-items:start;gap:10px;">
            <div style="width:30px;height:30px;border-radius:9px;background:rgba(124,58,237,.2);border:1px solid rgba(124,58,237,.35);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:900;color:#C4B5FD;flex-shrink:0;">TM</div>
            <div class="chat-ai">Xin chào! Tôi là Trợ lý AI Thiên Minh Networks.<br>Tôi có thể giúp bạn phân tích hồ sơ, kiểm tra điều kiện kỹ thuật, đánh giá chiết khấu và tư vấn quyết định thương mại.<br><br>Hãy hỏi tôi bất cứ điều gì về dự án hiện tại! 🚀</div>
          </div>
        </div>
        <!-- Input -->
        <div style="padding:14px 24px;border-top:1px solid var(--border);display:flex;gap:10px;flex-shrink:0;">
          <input class="input" id="chat-input" placeholder="Hỏi AI: 'Tại sao dự án này cần chuyển duyệt?'..." style="flex:1;" onkeydown="if(event.key==='Enter')sendChat()">
          <button class="btn-primary" onclick="sendChat()" style="flex-shrink:0;">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            Gửi
          </button>
        </div>
      </div>
    </div>

  </div><!-- end tab-panels -->
</div><!-- end #app -->

<!-- ============================================================
     MODALS
============================================================ -->

<!-- Pipeline Modal (accessible from landing) -->
<div id="pipeline-modal" class="modal-backdrop" style="display:none;" onclick="if(event.target===this)closeModal('pipeline-modal')">
  <div class="modal" style="max-width:720px;">
    <div class="modal-header">
      <div>
        <div class="modal-title">Sơ Đồ Luồng Hoạt Động Pipeline</div>
        <div class="modal-sub">Sheets → Cleaning → AI Process → Verify → Export & Cơ chế hoàn trả lỗi</div>
      </div>
      <button class="btn-close" onclick="closeModal('pipeline-modal')">✕</button>
    </div>
    <div class="space-y">
      <div class="pstep ps-blue">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap;">
          <span style="padding:3px 10px;border-radius:7px;background:rgba(59,130,246,.2);font-size:11px;font-weight:800;color:#93C5FD;">BƯỚC 1</span>
          <span style="font-size:13px;font-weight:700;color:white;">Tiếp Nhận Dữ Liệu Đầu Vào (Ingestion)</span>
          <span style="margin-left:auto;font-size:11px;color:#93C5FD;font-weight:600;">Google Sheets / CSV / DOCX</span>
        </div>
        <p style="font-size:12px;color:var(--muted);line-height:1.7;margin-bottom:10px;">Nhận URL Google Sheets (tự động chuyển <code style="color:#93C5FD;background:rgba(59,130,246,.15);padding:1px 5px;border-radius:4px;">/export?format=csv</code>), tải file <code style="color:#93C5FD;background:rgba(59,130,246,.15);padding:1px 5px;border-radius:4px;">.docx</code>, <code style="color:#93C5FD;background:rgba(59,130,246,.15);padding:1px 5px;border-radius:4px;">.csv</code> hoặc dán văn bản RFQ tự do.</p>
        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          <span class="badge b" style="font-size:10px;">✓ Regex Sheet ID & GID</span>
          <span class="badge b" style="font-size:10px;">✓ Word Paragraphs & Tables</span>
          <span class="badge b" style="font-size:10px;">✓ UTF-8-SIG CSV Parser</span>
        </div>
      </div>

      <div style="display:flex;justify-content:center;"><div style="padding:5px 14px;border-radius:99px;background:rgba(255,255,255,.04);border:1px solid var(--border);font-size:10px;color:var(--dim);font-weight:600;">↓ Chuyển sang Làm Sạch & Kiểm Định</div></div>

      <div class="pstep ps-indigo">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap;">
          <span style="padding:3px 10px;border-radius:7px;background:rgba(99,102,241,.2);font-size:11px;font-weight:800;color:#A5B4FC;">BƯỚC 2</span>
          <span style="font-size:13px;font-weight:700;color:white;">Làm Sạch & Chuẩn Hóa Dữ Liệu (Cleaning)</span>
        </div>
        <p style="font-size:12px;color:var(--muted);line-height:1.7;margin-bottom:10px;">Chuẩn hóa tên cột linh hoạt, loại bỏ dữ liệu rác, ép kiểu số, chuẩn hóa tiền VNĐ, đăng ký mã <code style="color:#A5B4FC;background:rgba(99,102,241,.15);padding:1px 5px;border-radius:4px;">TMN-RFQ-YYYYMMDD</code>.</p>
        <div style="padding:12px;border-radius:10px;background:rgba(244,63,94,.08);border:1px solid rgba(244,63,94,.25);">
          <span style="font-size:11px;font-weight:700;color:#FB7185;">⚠ Điểm Hoàn Trả Lỗi:</span>
          <p style="font-size:11px;color:var(--muted);margin-top:4px;line-height:1.6;">Nếu link Sheets sai, file Word không có bảng, file CSV trống → <strong style="color:#FB7185;">Toast Warning đỏ → Yêu cầu nhập lại từ Bước 1</strong></p>
        </div>
      </div>

      <div style="display:flex;justify-content:center;"><div style="padding:5px 14px;border-radius:99px;background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.25);font-size:10px;color:#34D399;font-weight:600;">✓ Dữ liệu hợp lệ → Chuyển sang AI Agent Engine</div></div>

      <div class="pstep ps-indigo">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap;">
          <span style="padding:3px 10px;border-radius:7px;background:rgba(99,102,241,.2);font-size:11px;font-weight:800;color:#A5B4FC;">BƯỚC 3</span>
          <span style="font-size:13px;font-weight:700;color:white;">Xử Lý Đa Tác Vụ AI Agent (Process Engine)</span>
        </div>
        <div class="g2" style="gap:8px;">
          <div style="padding:10px;border-radius:9px;background:rgba(99,102,241,.07);border:1px solid rgba(99,102,241,.18);"><span style="font-size:10px;font-weight:700;color:#A5B4FC;display:block;margin-bottom:3px;">2a. Trích Xuất</span><p style="font-size:11px;color:var(--muted);">Ngân sách trần, deadline, SLA, phân loại dự án</p></div>
          <div style="padding:10px;border-radius:9px;background:rgba(99,102,241,.07);border:1px solid rgba(99,102,241,.18);"><span style="font-size:10px;font-weight:700;color:#A5B4FC;display:block;margin-bottom:3px;">2b. Đối Chiếu</span><p style="font-size:11px;color:var(--muted);">Khớp 13 mã chuẩn, tính lead-time + ngày thi công</p></div>
          <div style="padding:10px;border-radius:9px;background:rgba(99,102,241,.07);border:1px solid rgba(99,102,241,.18);"><span style="font-size:10px;font-weight:700;color:#A5B4FC;display:block;margin-bottom:3px;">2c. Tính Giá</span><p style="font-size:11px;color:var(--muted);">4 Tier chiết khấu, List Price, VAT 10%, COGS 68%</p></div>
          <div style="padding:10px;border-radius:9px;background:rgba(99,102,241,.07);border:1px solid rgba(99,102,241,.18);"><span style="font-size:10px;font-weight:700;color:#A5B4FC;display:block;margin-bottom:3px;">2d. Ma Trận</span><p style="font-size:11px;color:var(--muted);">Sinh ma trận, kiểm 5 cờ Escalation, tạo phiếu duyệt</p></div>
        </div>
      </div>

      <div style="display:flex;justify-content:center;"><div style="padding:5px 14px;border-radius:99px;background:rgba(255,255,255,.04);border:1px solid var(--border);font-size:10px;color:var(--dim);font-weight:600;">↓ Chuyển sang Điểm Kiểm Tra Quyết Định</div></div>

      <div class="pstep ps-amber">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap;">
          <span style="padding:3px 10px;border-radius:7px;background:rgba(245,158,11,.2);font-size:11px;font-weight:800;color:#FCD34D;">BƯỚC 4</span>
          <span style="font-size:13px;font-weight:700;color:white;">Kiểm Tra & Phê Duyệt Con Người (Verify)</span>
          <span style="margin-left:auto;font-size:11px;color:#FCD34D;font-weight:600;">Human-in-the-loop</span>
        </div>
        <div class="g2" style="gap:8px;">
          <div style="padding:10px;border-radius:9px;background:rgba(16,185,129,.07);border:1px solid rgba(16,185,129,.22);"><span style="font-size:10px;font-weight:700;color:#34D399;display:block;margin-bottom:3px;">1. PASS → Bước 5</span><p style="font-size:11px;color:var(--muted);">100% chuẩn, trong hạn mức</p></div>
          <div style="padding:10px;border-radius:9px;background:rgba(245,158,11,.07);border:1px solid rgba(245,158,11,.22);"><span style="font-size:10px;font-weight:700;color:#FCD34D;display:block;margin-bottom:3px;">2. ESCALATE → Bước 5</span><p style="font-size:11px;color:var(--muted);">Hội đồng ký waiver ngoại lệ</p></div>
          <div style="padding:10px;border-radius:9px;background:rgba(234,179,8,.07);border:2px solid rgba(234,179,8,.28);"><span style="font-size:10px;font-weight:700;color:#FDE047;display:block;margin-bottom:3px;">3. ADJUST ↩ Bước 3</span><p style="font-size:11px;color:var(--muted);">AI tái tính toán sau điều chỉnh</p></div>
          <div style="padding:10px;border-radius:9px;background:rgba(244,63,94,.07);border:1px solid rgba(244,63,94,.22);"><span style="font-size:10px;font-weight:700;color:#FB7185;display:block;margin-bottom:3px;">4. REJECT → Dừng</span><p style="font-size:11px;color:var(--muted);">Ngân sách &lt;70% COGS</p></div>
        </div>
      </div>

      <div style="display:flex;justify-content:center;"><div style="padding:5px 14px;border-radius:99px;background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.25);font-size:10px;color:#34D399;font-weight:600;">✓ Đã Phê Duyệt → Xuất Hồ Sơ Bàn Giao</div></div>

      <div class="pstep ps-green">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap;">
          <span style="padding:3px 10px;border-radius:7px;background:rgba(16,185,129,.2);font-size:11px;font-weight:800;color:#6EE7B7;">BƯỚC 5</span>
          <span style="font-size:13px;font-weight:700;color:white;">Hoàn Thiện & Bàn Giao (Export & Deliverables)</span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;text-align:center;">
          <div style="padding:10px;border-radius:9px;background:rgba(6,182,212,.1);border:1px solid rgba(6,182,212,.25);font-size:10px;font-weight:700;color:#22D3EE;">1. Bảng Đáp Ứng</div>
          <div style="padding:10px;border-radius:9px;background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.25);font-size:10px;font-weight:700;color:#34D399;">2. Chào Giá</div>
          <div style="padding:10px;border-radius:9px;background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.25);font-size:10px;font-weight:700;color:#FCD34D;">3. Phiếu Duyệt</div>
          <div style="padding:10px;border-radius:9px;background:rgba(139,92,246,.1);border:1px solid rgba(139,92,246,.25);font-size:10px;font-weight:700;color:#C4B5FD;">4. Hồ Sơ KT</div>
        </div>
      </div>
    </div>
    <div style="margin-top:20px;text-align:right;"><button class="btn-ghost" onclick="closeModal('pipeline-modal')">Đóng</button></div>
  </div>
</div>

<!-- Meeting Modal -->
<div id="meeting-modal" class="modal-backdrop" style="display:none;" onclick="if(event.target===this)closeModal('meeting-modal')">
  <div class="modal" style="max-width:420px;">
    <div class="modal-header">
      <div>
        <div class="modal-title">Họp Hội Đồng Chuyển Duyệt</div>
        <div class="modal-sub">Phiên họp khẩn — Duyệt ngoại lệ</div>
      </div>
      <button class="btn-close" onclick="closeModal('meeting-modal')">✕</button>
    </div>
    <div style="padding:14px;border-radius:12px;background:rgba(245,158,11,.07);border:1px solid rgba(245,158,11,.2);margin-bottom:16px;">
      <div style="font-size:11px;font-weight:700;color:#FCD34D;margin-bottom:8px;">Thành Phần Tham Dự:</div>
      <div style="display:flex;flex-direction:column;gap:5px;">
        <div style="display:flex;align-items:center;gap:7px;font-size:11px;color:var(--muted);"><span style="width:6px;height:6px;border-radius:50%;background:#C4B5FD;"></span>Lê Hoàng Minh — Tổng Giám Đốc (Chủ trì)</div>
        <div style="display:flex;align-items:center;gap:7px;font-size:11px;color:var(--muted);"><span style="width:6px;height:6px;border-radius:50%;background:#FBCFE8;"></span>Trần Nam — Trưởng phòng Kinh doanh</div>
        <div style="display:flex;align-items:center;gap:7px;font-size:11px;color:var(--muted);"><span style="width:6px;height:6px;border-radius:50%;background:#A5F3FC;"></span>Nguyễn Văn Kỹ — Kỹ thuật trưởng</div>
      </div>
    </div>
    <div style="margin-bottom:14px;">
      <div style="font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:var(--dim);margin-bottom:7px;">Điều Chỉnh Chiết Khấu (nếu cần)</div>
      <input class="input" type="number" placeholder="% chiết khấu được duyệt (ví dụ: 10)">
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
      <button class="btn-ghost" onclick="closeModal('meeting-modal')" style="justify-content:center;">Hủy</button>
      <button class="btn-primary" onclick="confirmWaiver()" style="justify-content:center;">✓ Ký Duyệt Ngoại Lệ</button>
    </div>
  </div>
</div>

<!-- ============================================================
     JAVASCRIPT
============================================================ -->
<script>
  // ======= NAVIGATION =======
  function goToApp() {
    document.getElementById('landing').classList.remove('active');
    document.getElementById('app').classList.add('active');
  }
  function goToLanding() {
    document.getElementById('app').classList.remove('active');
    document.getElementById('landing').classList.add('active');
  }

  // ======= TABS =======
  const TABS = ['overview','input','analysis','decision','export','chat'];
  function switchTab(name) {
    TABS.forEach(t => {
      document.getElementById('tab-'+t).classList.toggle('active', t===name);
      document.getElementById('panel-'+t).classList.toggle('active', t===name);
    });
  }

  // ======= MODALS =======
  function openModal(id) { document.getElementById(id).style.display='flex'; }
  function closeModal(id) { document.getElementById(id).style.display='none'; }

  // ======= TOAST =======
  function showToast(title, msg, type='info') {
    const c = document.getElementById('toast-container');
    const t = document.createElement('div');
    const colors = {
      success:{ icon:'✓', bg:'rgba(16,185,129,.8)',  border:'rgba(16,185,129,.35)'  },
      warning:{ icon:'!', bg:'rgba(245,158,11,.8)',  border:'rgba(245,158,11,.35)'  },
      danger: { icon:'✕', bg:'rgba(244,63,94,.8)',   border:'rgba(244,63,94,.35)'   },
      info:   { icon:'i', bg:'rgba(59,130,246,.8)',   border:'rgba(59,130,246,.35)'  },
    };
    const cl = colors[type]||colors.info;
    t.className = 'toast';
    t.style.borderColor = cl.border;
    t.innerHTML = `
      <div style="width:26px;height:26px;border-radius:50%;background:${cl.bg};display:flex;align-items:center;justify-content:center;color:white;font-size:11px;font-weight:900;flex-shrink:0;">${cl.icon}</div>
      <div>
        <div style="font-size:13px;font-weight:700;color:white;margin-bottom:2px;">${title}</div>
        <div style="font-size:11px;color:var(--muted);line-height:1.5;">${msg}</div>
      </div>`;
    c.appendChild(t);
    setTimeout(()=>{t.style.transition='all .4s';t.style.opacity='0';t.style.transform='translateX(20px)';setTimeout(()=>t.remove(),400);},4000);
  }

  // ======= PRESET DATA =======
  const DATA = {
    alpha:{
      rfq:'RFQ-2026-ALPHATECH-01', customer:'AlphaTech Việt Nam', balance:'378.650.800 VNĐ',
      cogs:'249,0 Triệu', rec:'HỢP LỆ 100%', rec_cls:'g',
      kv:'378,6M', kd:'Khả Thi', km:'27,7%', ks:'Phê Duyệt', ks_b:'g', ks_bt:'Tự động',
      kdb:'80%', kmb:'45%',
      b1:'80%', b2:'65%', b3:'45%',
      an:'7 Hạng mục', as:'100% đạt chuẩn', ap:'366.2M VNĐ', ap_c:'g', al:'PoE+ 370W',
      bn:'12 Ngày',    bs:'Hạn 30 ngày',    bp:'Khả thi',    bp_c:'b', bl:'Lead 5d + Thi công 7d',
      cn:'6,0% CK',    cs:'Lãi gộp 27,7%',  cp:'Hợp lệ',     cp_c:'g', cl:'Trần 8,0% Tier 2',
      g_comp:'196', g_comp_t:'87%', g_sched:'163', g_sched_t:'72%',
      sum:'Phương án được AI thẩm định đủ điều kiện phát hành chào giá.',
      pf:'95,2 Tr', pc:'249,0 Tr',
      sm:'Đã đối chiếu 100% yêu cầu. Hạng mục PoE+ và Wi-Fi 6 đều khớp catalog.',
      cm:'Nếu chiết khấu trong hạn mức Tier 2 (8%), cho phép xuất báo giá ngay.',
      tm:'Thời gian thi công 7 ngày. Lịch đội kỹ sư trống, hoàn toàn đáp ứng.',
      s1:'↑ 80% Tương thích kỹ thuật', s2:'◷ Deadline: Trước 25/12', s3:'✓ Thẩm quyền: Trưởng phòng KD',
    },
    vietfin:{
      rfq:'RFQ-2026-VIETFIN-CORE-02', customer:'Ngân hàng VietFin Bank', balance:'520.300.000 VNĐ',
      cogs:'374,0 Triệu', rec:'CẦN HỌP HỘI ĐỒNG', rec_cls:'a',
      kv:'520,3M', kd:'Lịch Gấp', km:'18,0%', ks:'Chuyển Duyệt', ks_b:'a', ks_bt:'Hội đồng',
      kdb:'30%', kmb:'25%',
      b1:'100%', b2:'85%', b3:'90%',
      an:'5 Hạng mục', as:'Có ngoài catalog!', ap:'550.0M VNĐ', ap_c:'a', al:'DDoS ngoài catalog',
      bn:'24 Ngày',    bs:'Chỉ cho 15 ngày',  bp:'Lịch gấp',   bp_c:'r', bl:'Deadline cực gấp',
      cn:'14,0% CK',   cs:'Vượt trần Tier 2', cp:'Vượt khung', cp_c:'r', cl:'Trần 8,0% Tier 2',
      g_comp:'141', g_comp_t:'70%', g_sched:'90', g_sched_t:'45%',
      sum:'Cần phê duyệt ngoại lệ từ Hội đồng Ban Giám Đốc trước khi nộp bản chào giá.',
      pf:'99,0 Tr', pc:'374,0 Tr',
      sm:'Khách yêu cầu chiết khấu 14% và thiết bị DDoS inline ngoài catalog.',
      cm:'Cần họp Hội đồng để duyệt mức chiết khấu 12% và điều phối nhập khẩu ủy quyền.',
      tm:'Thời gian 15 ngày rất gấp, cần huy động 2 ca kỹ sư làm việc ban đêm.',
      s1:'↑ 100% Yêu cầu KT', s2:'◷ Deadline gấp 15 ngày', s3:'✓ TGĐ phê duyệt ngoại lệ',
    },
    ankhang:{
      rfq:'RFQ-2026-ANKHANG-HOSPITAL-03', customer:'BV ĐKQT An Khang', balance:'50.000.000 VNĐ (Thiếu hụt)',
      cogs:'632,4 Triệu', rec:'ĐỀ XUẤT LOẠI BỎ', rec_cls:'r',
      kv:'50M', kd:'Bất Khả Thi', km:'-580 Tr', ks:'Loại Bỏ', ks_b:'r', ks_bt:'Từ chối',
      kdb:'5%', kmb:'5%',
      b1:'30%', b2:'20%', b3:'10%',
      an:'4 Hạng mục', as:'Giá trị thực >1 tỷ', ap:'930.0M VNĐ', ap_c:'r', al:'Yêu cầu phi thực tế',
      bn:'26 Ngày',    bs:'Đòi xong trong 3 ngày', bp:'Bất khả thi', bp_c:'r', bl:'Deadline 3 ngày',
      cn:'Thiếu 92%',  cs:'Ngân sách chỉ 50M', cp:'Thua lỗ', cp_c:'r', cl:'Ngân sách 50M',
      g_comp:'80', g_comp_t:'40%', g_sched:'20', g_sched_t:'10%',
      sum:'Tử huyệt thương mại: Đề xuất từ chối tham gia chào giá.',
      pf:'-580 Tr', pc:'632,4 Tr',
      sm:'Ngân sách khách hàng 50 triệu trong khi thiết bị yêu cầu tới 930 triệu.',
      cm:'Từ chối tham gia để tránh thua lỗ và vi phạm phạt tiến độ.',
      tm:'Thời hạn 3 ngày là bất khả thi vật lý cho hạ tầng Core L3.',
      s1:'↑ 30% Tương thích', s2:'◷ Deadline 3 ngày!', s3:'✓ TGĐ từ chối tham gia',
    }
  };

  let currentKey = 'alpha';

  function set(id, val) { const e=document.getElementById(id); if(e) e.textContent=val; }
  function setBadge(id, val, cls) {
    const e=document.getElementById(id);
    if(!e) return;
    e.textContent=val;
    e.className='badge '+cls;
  }
  function setWidth(id, val) { const e=document.getElementById(id); if(e) e.style.width=val; }
  function setAttr(id, attr, val) { const e=document.getElementById(id); if(e) e.setAttribute(attr,val); }

  function loadPreset(key) {
    currentKey = key;
    const d = DATA[key]; if(!d) return;

    // Overview
    set('ov-rfq', d.rfq); setBadge('ov-rec', d.rec, d.rec_cls);
    set('card-rfq', d.rfq); set('card-balance', d.balance); set('card-customer', d.customer); set('card-cogs', d.cogs);
    set('kpi-val', d.kv); set('kpi-days', d.kd); set('kpi-margin', d.km);
    set('kpi-status', d.ks); setBadge('kpi-status-badge', d.ks_bt, d.ks_b+' text-[10px]');
    setWidth('kpi-days-bar', d.kdb); setWidth('kpi-margin-bar', d.kmb);
    setAttr('g-compliance','stroke-dasharray',d.g_comp+' 226'); set('g-compliance-txt', d.g_comp_t);
    setAttr('g-schedule','stroke-dasharray',d.g_sched+' 226'); set('g-schedule-txt', d.g_sched_t);
    set('g-summary', d.sum); set('profit-val', d.pf); set('cogs-val', d.pc);

    // Analysis
    set('bar1-val',d.b1); setWidth('bar1-fill',d.b1);
    set('bar2-val',d.b2); setWidth('bar2-fill',d.b2);
    set('bar3-val',d.b3); setWidth('bar3-fill',d.b3);
    set('a-num',d.an); set('a-sub',d.as); setBadge('a-pill',d.ap,d.ap_c); set('a-lbl',d.al);
    set('b-num',d.bn); set('b-sub',d.bs); setBadge('b-pill',d.bp,d.bp_c); set('b-lbl',d.bl);
    set('c-num',d.cn); set('c-sub',d.cs); setBadge('c-pill',d.cp,d.cp_c); set('c-lbl',d.cl);
    set('stat1',d.s1); set('stat2',d.s2); set('stat3',d.s3);

    // Decision messages
    set('msg-sales',d.sm); set('msg-ceo',d.cm); set('msg-tech',d.tm);

    // Download links
    ['dl-matrix','dl-quotation','dl-approval'].forEach((id,i)=>{
      const paths=['requirements_matrix','official_quotation','approval_form'];
      const el=document.getElementById(id);
      if(el) el.href=`/api/download/${paths[i]}?rfq_code=${d.rfq}`;
    });
  }

  // ======= HOLO CARD TILT =======
  const holo = document.getElementById('holo-card');
  if(holo) {
    holo.addEventListener('mousemove', e => {
      const r=holo.getBoundingClientRect();
      const rx=((e.clientY-r.top-r.height/2)/r.height)*-10;
      const ry=((e.clientX-r.left-r.width/2)/r.width)*10;
      holo.style.transform=`perspective(800px) rotateX(${rx}deg) rotateY(${ry}deg) scale(1.02)`;
    });
    holo.addEventListener('mouseleave',()=>{ holo.style.transform=''; });
  }

  // ======= ACTIONS =======
  function handleAction(type) {
    if(type==='approve') {
      showToast('Phê Duyệt', 'Trưởng phòng KD đã duyệt. Chuyển sang xuất file!','success');
      setTimeout(()=>switchTab('export'),700);
    } else {
      showToast('Loại Bỏ', 'Đã xác nhận từ chối tham gia dự án.','danger');
    }
  }

  function confirmWaiver() {
    closeModal('meeting-modal');
    showToast('Hội Đồng Phê Duyệt','TGĐ đã ký duyệt ngoại lệ! Sẵn sàng xuất báo giá.','success');
    setTimeout(()=>switchTab('export'),700);
  }

  function handleGSheet() {
    const url = document.getElementById('gsheet-url').value.trim();
    if(!url){showToast('Cảnh báo','Vui lòng nhập đường dẫn Google Sheets!','warning');return;}
    loadPreset('alpha');
    set('card-customer','Google Sheets Online');
    showToast('Thành công','Đã kết nối và đồng bộ từ Google Sheets!','success');
    switchTab('overview');
  }

  function handleFile(e) {
    const f=e.target.files[0]; if(!f) return;
    const name=f.name.toLowerCase();
    if(name.includes('vietfin')) loadPreset('vietfin');
    else if(name.includes('ankhang')) loadPreset('ankhang');
    else loadPreset('alpha');
    showToast('Tải lên hoàn tất','Đã bóc tách dữ liệu từ: '+f.name,'success');
    switchTab('overview');
  }

  // ======= CHAT =======
  let chatKey = 'alpha';
  function sendChat() {
    const inp = document.getElementById('chat-input');
    const text = inp.value.trim(); if(!text) return;
    const c = document.getElementById('chat-msgs');
    inp.value = '';

    // User
    const ub=document.createElement('div');
    ub.style.cssText='display:flex;justify-content:flex-end;';
    ub.innerHTML=`<div class="chat-user">${text}</div>`;
    c.appendChild(ub); c.scrollTop=c.scrollHeight;

    // Loading
    const lb=document.createElement('div');
    lb.style.cssText='display:flex;align-items:start;gap:10px;';
    lb.innerHTML=`<div style="width:30px;height:30px;border-radius:9px;background:rgba(124,58,237,.2);border:1px solid rgba(124,58,237,.35);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:900;color:#C4B5FD;flex-shrink:0;">TM</div><div class="chat-ai" style="display:flex;align-items:center;gap:5px;"><span style="width:5px;height:5px;border-radius:50%;background:#A78BFA;animation:pulse 1s infinite;display:block;"></span><span style="width:5px;height:5px;border-radius:50%;background:#EC4899;animation:pulse 1s .15s infinite;display:block;"></span><span style="width:5px;height:5px;border-radius:50%;background:#22D3EE;animation:pulse 1s .3s infinite;display:block;"></span><span style="font-size:11px;color:var(--muted);margin-left:4px;">Gemini đang suy luận...</span></div>`;
    c.appendChild(lb); c.scrollTop=c.scrollHeight;

    fetch('/api/gemini-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:text,rfq_code:currentKey})})
    .then(r=>r.json())
    .then(data=>{
      lb.remove();
      const ab=document.createElement('div');
      ab.style.cssText='display:flex;align-items:start;gap:10px;';
      ab.innerHTML=`<div style="width:30px;height:30px;border-radius:9px;background:rgba(124,58,237,.2);border:1px solid rgba(124,58,237,.35);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:900;color:#C4B5FD;flex-shrink:0;">TM</div><div class="chat-ai">${data.reply||'Đã ghi nhận.'}</div>`;
      c.appendChild(ab); c.scrollTop=c.scrollHeight;
    })
    .catch(err=>{
      lb.remove();
      const eb=document.createElement('div');
      eb.style.cssText='display:flex;align-items:start;gap:10px;';
      eb.innerHTML=`<div style="width:30px;height:30px;border-radius:9px;background:rgba(244,63,94,.2);border:1px solid rgba(244,63,94,.35);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:900;color:#FB7185;flex-shrink:0;">!</div><div class="chat-ai" style="border-color:rgba(244,63,94,.3);color:#FB7185;">Lỗi kết nối: ${err.message}</div>`;
      c.appendChild(eb);
    });
  }

  // ======= INIT =======
  window.addEventListener('DOMContentLoaded', ()=>{ loadPreset('alpha'); });
</script>
</body>
</html>
