              <div class="card-sub" style="margin-bottom:12px;">Hỗ trợ .docx và .csv (mã hóa UTF-8)</div>
              <label style="display:block;padding:20px;border-radius:12px;border:2px dashed var(--border2);text-align:center;cursor:pointer;transition:all .2s;" onmouseover="this.style.borderColor='rgba(124,58,237,.5)'" onmouseout="this.style.borderColor='var(--border2)'">
                <svg width="28" height="28" fill="none" stroke="var(--dim)" stroke-width="1.5" viewBox="0 0 24 24" style="margin:0 auto 8px;display:block;"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <div style="font-size:12px;color:var(--muted);">Kéo thả hoặc <span style="color:#A78BFA;font-weight:700;">chọn file</span></div>
                <input type="file" accept=".docx,.csv" class="hidden" style="display:none;" onchange="handleFile(event)">
              </label>
            </div>

            <div class="card">
              <div class="card-label">Văn Bản Thô</div>
              <div class="card-title" style="margin-bottom:4px;">Copy-paste nội dung RFQ</div>
              <div class="card-sub" style="margin-bottom:12px;">Dán trực tiếp email, chat hoặc tài liệu word</div>
              <textarea class="input" rows="4" placeholder="Dán nội dung yêu cầu chào giá vào đây..." style="resize:vertical;"></textarea>
              <button class="btn-ghost" style="margin-top:8px;width:100%;justify-content:center;" onclick="showToast('Phân Tích','Đang xử lý văn bản...','info')">Phân Tích Văn Bản</button>
